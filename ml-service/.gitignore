# Testing / coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ML artifacts. The match-predictor pickle (~3 MB) ships in-repo so
# Railway builds straight from `docker build .` without needing to
# retrain; larger / per-feature pickles stay out of git until we have a
# release-artifact pipeline.
trained_models/*
!trained_models/.gitkeep
!trained_models/match_predictor.pkl
*.joblib

# Raw training data — large CSV archive, regenerated by
# `scripts/download_football_data.py`.
data/raw/
data/processed/

# Env
.env
.env.local
