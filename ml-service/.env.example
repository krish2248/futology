# Bearer token the front-end must send via `Authorization: Bearer ...`.
# When unset locally, auth is bypassed for friction-free dev. MUST be
# set on Railway in production.
ML_SERVICE_TOKEN=

# Comma-separated origins allowed by CORS. Defaults to localhost +
# https://krish2248.github.io when unset.
ML_ALLOWED_ORIGINS=

# Phase 3 v0.2 — paths to trained model artefacts loaded at startup.
# Leave blank in v0.1 (stub mode).
MATCH_PREDICTOR_PATH=
PLAYER_CLUSTERER_PATH=
TRANSFER_VALUE_PATH=
