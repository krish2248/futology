# =============================================================================
# FUTOLOGY - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values
# For demo mode, only DEMO_MODE=true is required
# =============================================================================

# === Supabase (Database + Auth + Realtime) ===
# Publishable values — safe to commit / share. They identify your
# Supabase project from the browser. Rotate via the dashboard if the
# project ever moves: https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://zlivysbodcgmalycetfr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_hcHSeaKUHpy2Bh8SvtK1-A_2ckiiuAC
# Service-role key — NEVER expose to the browser. Only used by
# server-side scripts or the Vercel SSR target (if you add one later).
# Paste the rotated value into .env.local, do not commit.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# === API-Football (RapidAPI) ===
# Sign up: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com

# === football-data.org (free tier available) ===
# Sign up: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your-football-data-key

# === NewsAPI ===
# Sign up: https://newsapi.org/register
NEWS_API_KEY=your-newsapi-key

# === Resend (email notifications) ===
# Sign up: https://resend.com/signup
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=noreply@futology.com

# === ML Service (FastAPI) ===
# Browser-side (NEXT_PUBLIC_*) because the front-end is a static export
# and calls the service directly. Leave NEXT_PUBLIC_ML_API_URL unset to
# fall back to the local seeded predictor (lib/ml/predictor.ts).
NEXT_PUBLIC_ML_API_URL=http://localhost:8000
NEXT_PUBLIC_ML_API_TOKEN=
# Server-side legacy keys (kept for the future Vercel cutover where API
# routes proxy to the ML service and the token stays server-side).
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=your-ml-service-token

# === Reddit (sentiment analysis) ===
# Create app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=Futology/1.0

# === Twitter API (optional) ===
# Apply: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# === Upstash Redis (caching) ===
# Create DB: https://upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# === Feature Flags ===
DEMO_MODE=true
ENABLE_TWITTER_SENTIMENT=false

# === App Configuration ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Futology
